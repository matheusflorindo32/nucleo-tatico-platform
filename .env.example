# Copy to .env and replace every CHANGE_ME value locally.
# Never commit the real .env file.

DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
GRAFANA_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD

# Backend-only secrets
SUPABASE_SERVICE_KEY=CHANGE_ME_BACKEND_ONLY_SERVICE_ROLE_KEY

# Public/client-safe configuration only
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=CHANGE_ME_PUBLIC_ANON_KEY
VITE_API_URL=http://localhost:3000
